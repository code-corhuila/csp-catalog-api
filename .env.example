# Names and placeholders only: never a real value. Copy to .env for local runs.
# Every variable the service reads is listed here; the Pull Requests that add configuration add their names.
PORT=8082
# Database of this domain (Annex J.5): the replica set of csp-infra-mongo and the login user of the catalog;
# replace the placeholder password in your own .env. The pool and the timeouts are declared in
# catalog-app/src/main/resources/application.yml (Norma 5.3.10).
MONGODB_URI=mongodb://catalog_app:change-me@localhost:27017/catalog_db?replicaSet=rs0
# Public key of the identity service that validates every token (Norma 5.3.7).
# Set one of the two, not both: the PEM itself, or the path of the file that holds it.
JWT_PUBLIC_KEY=change-me
JWT_PUBLIC_KEY_FILE=change-me
# Certificate chain and private key the service serves HTTPS with (ADR-067): PEM files mounted by the platform, issued by the
# internal CA of the environment with the names catalog-api and localhost. The service has no plain HTTP listener and does not
# start without both files. The callers (booking-service, the gateway) trust the CA through CATALOG_TLS_CA_FILE, a public file.
CATALOG_TLS_CERTIFICATE_FILE=change-me
CATALOG_TLS_PRIVATE_KEY_FILE=change-me
CATALOG_TLS_CA_FILE=change-me
# Subjects (sub of the service tokens) allowed to read the availability of a showtime (ADR-042), comma separated.
# Absent: booking-service. Present but empty: nobody is allowed.
SERVICE_SUBJECTS=booking-service
