# Names and placeholders only: never a real value. Copy to .env for local runs.
# Every variable the service reads is listed here; the Pull Requests that add configuration add their names.
PORT=8082
# Database of this domain (Annex J.5): the replica set of csp-infra-mongo and the login user of the catalog;
# replace the placeholder password in your own .env. The pool and the timeouts are declared in
# catalog-app/src/main/resources/application.yml (Norma 5.3.10).
MONGODB_URI=mongodb://catalog_app:change-me@localhost:27017/catalog_db?replicaSet=rs0
